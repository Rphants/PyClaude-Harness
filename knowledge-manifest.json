{
  "version": 1,
  "description": "Shared knowledge corpus manifest for the super-agent MVP. These sources should be ingested into the shared brain/vector layer so every agent can retrieve official guidance, product constraints, and operating context.",
  "ingestion_targets": {
    "human_brain": [
      "CLAUDE.md",
      "CODEX.md",
      "agents/*/AGENT-BRAIN.md"
    ],
    "machine_brain": [
      "AGENT-BRAIN.jsonl",
      "shared vector index",
      "official docs snapshots"
    ]
  },
  "required_corpora": [
    {
      "id": "claudepy",
      "name": "ClaudePY / Claude Code",
      "priority": "critical",
      "why_it_matters": "The harness is improving a forked Claude Code runtime. The agent needs source material for CLI behavior, auth modes, output envelopes, tool patterns, and failure modes.",
      "runtime_dependencies": [
        "ANTHROPIC_API_KEY",
        "claude CLI on target runtime"
      ],
      "sources": [
        {
          "label": "Claude Code Docs Overview",
          "url": "https://code.claude.com/docs/en/overview",
          "kind": "official_docs"
        },
        {
          "label": "PyClaude-Harness Agent Brain",
          "url": "local://CLAUDE.md",
          "kind": "internal_context"
        },
        {
          "label": "PyClaude-Harness Codex Brain",
          "url": "local://CODEX.md",
          "kind": "internal_context"
        }
      ]
    },
    {
      "id": "canva_connect",
      "name": "Canva Connect API",
      "priority": "critical",
      "why_it_matters": "Needed for polished creative production and export flows in the ad-engine.",
      "runtime_dependencies": [
        "CANVA_CLIENT_ID",
        "CANVA_CLIENT_SECRET",
        "CANVA_REFRESH_TOKEN"
      ],
      "sources": [
        {
          "label": "Connect Overview",
          "url": "https://www.canva.dev/docs/connect/",
          "kind": "official_docs"
        },
        {
          "label": "Authentication",
          "url": "https://www.canva.dev/docs/connect/authentication/",
