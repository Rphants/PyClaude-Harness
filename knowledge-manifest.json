        },
        {
          "label": "API Requests and Responses",
          "url": "https://www.canva.dev/docs/connect/api-requests-responses/",
          "kind": "official_docs"
        }
      ]
    },
    {
      "id": "figma",
      "name": "Figma API and design workflows",
      "priority": "critical",
      "why_it_matters": "Needed for design-system context, file inspection, structured creative generation, and MCP-assisted design operations.",
      "runtime_dependencies": [
        "FIGMA_ACCESS_TOKEN or Figma MCP session"
      ],
      "sources": [
        {
          "label": "Figma REST API",
